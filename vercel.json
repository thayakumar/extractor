{
  "builds": [
    { "src": "api/config.py", "use": "@vercel/python" },
    { "src": "api/proxy.py", "use": "@vercel/python" },
    {
      "src": "api/scribd.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/config(.*)", "dest": "/api/config.py" },
    { "src": "/api/proxy(.*)", "dest": "/api/proxy.py" },
    { "src": "/api/scribd", "dest": "/api/scribd.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
